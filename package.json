{
  "name": "crosssqa",
  "version": "1.1.0",
  "description": "Reusable Playwright and TypeScript QA framework for UI, security, accessibility, and API testing",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:security": "playwright test tests/security.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:api": "playwright test tests/api.spec.ts",
    "test:juice-shop": "playwright test tests/juice-shop.spec.ts --project=chromium",
    "test:helpers": "playwright test tests/helpers/qa.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
